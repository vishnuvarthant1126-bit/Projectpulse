# Copy to .env and fill in. .env is git-ignored; secrets are only read by the backend.

# --- Answer generation ------------------------------------------------------
# none      -> demo mode: precomputed sample answers + retrieved evidence only
# anthropic -> Claude Messages API
# openai    -> OpenAI Chat Completions or any compatible server (set LLM_BASE_URL)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
# LLM_BASE_URL=            # e.g. https://api.openai.com/v1 or http://host.docker.internal:11434/v1
# LLM_MAX_TOKENS=2500
# LLM_TIMEOUT_S=90

# --- Embeddings ---------------------------------------------------------------
# local  -> all-MiniLM-L6-v2 (ONNX) on CPU; downloaded at Docker build time
# openai -> OpenAI-compatible /embeddings endpoint
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL_DIR=./models/all-MiniLM-L6-v2
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# (Changing the embedding model creates new vector collections; re-upload or reset projects.)

# --- Chunking and retrieval -------------------------------------------------
# CHUNK_SIZE=900                # characters
# CHUNK_OVERLAP=150
# RETRIEVAL_CANDIDATES=20       # per retriever, before fusion
# ANSWER_MAX_PASSAGES=8         # passages sent to the answer model
# RRF_K=60
# PLAN_QUOTA=2                  # min original-plan passages for change questions
# UPDATE_QUOTA=3                # min update passages for change questions

# --- Uploads, storage, logging ------------------------------------------------
# MAX_UPLOAD_MB=10
# DATA_DIR=./data
# CORS_ORIGINS=["http://localhost:3000"]
# LOG_DOCUMENT_CONTENT=false    # keep false: questions and passages are not logged

# --- Evaluation judge (optional; defaults to the LLM_* settings) --------------
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-5
# JUDGE_API_KEY=
